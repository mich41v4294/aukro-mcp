# Aukro MCP Server Configuration (All fields are optional — server works anonymously by default)

# Option 1: Browser Session Cookie(s) from https://aukro.cz
# Either pass the full Cookie header string from browser DevTools:
# AUKRO_COOKIES="SESSION=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx; aukro-token=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy; XSRF-TOKEN=zzzz"
# Or pass individual cookies:
# AUKRO_SESSION="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# AUKRO_XSRF_TOKEN="zzzz"
# AUKRO_TOKEN="yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"

# Option 2: OAuth2 Bearer Token & Refresh Token (Mobile PKCE client auto-refresh supported)
# AUKRO_ACCESS_TOKEN="eyJhbGciOiJSUzI1NiIs..."
# AUKRO_REFRESH_TOKEN="def50200..."
# AUKRO_OAUTH_CLIENT_ID="aukro-backend-web-mobile-app-android"

# Option 3: Interactive Browser Login (`aukro_login_interactive`)
# Optional custom path to Chrome/Brave/Edge/Chromium binary:
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Marketplace Localization & Preferences
AUKRO_BASE_URL="https://aukro.cz/backend-web/api"
AUKRO_WEB_URL="https://aukro.cz"
AUKRO_CURRENCY="CZK"
AUKRO_LANGUAGE="cs-CZ"
AUKRO_SUBBRAND="BAZAAR"

# Path to persistent credentials file (defaults to ~/.config/aukro-mcp/credentials.json)
# AUKRO_CREDENTIALS_FILE="/path/to/.config/aukro-mcp/credentials.json"
